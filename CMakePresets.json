{
    "version": 10,
    "configurePresets" : [
        {
            "$comment": "Configuration common to all available presets.",
            "name"          : "default",
            "hidden"        : true,
            "binaryDir"     : "${sourceDir}/build-with-${presetName}",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE"     : "Release",
                "CMAKE_CXX_STANDARD"   : "20",
                "CMAKE_CXX_EXTENSIONS" : "OFF",
                "CMAKE_C_COMPILER"     : "should-not-be-needed"
            }
        },
        {
            "$comment": "Inherit from this preset to use the gcc compiler family.",
            "name"           : "gcc",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "g++"}
        },
        {
            "$comment": "Inherit from this preset to use the clang compiler family.",
            "name"           : "clang",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "clang++"}
        },
        {
            "$comment": "Inherit from this preset to use the intel compiler family.",
            "name"           : "intel",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "icpx"}
        },
        {
            "$comment": "Inherit from this preset to use the rocm compiler family.",
            "name"           : "rocm",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "hipcc"}
        },
        {
            "$comment": "Inherit from this preset to use nvcc with gcc as the host compiler.",
            "name"           : "nvidia-gcc",
            "hidden"         : true,
            "cacheVariables" : {
                "CMAKE_CXX_COMPILER" : "$penv{Kokkos_ROOT}/bin/nvcc_wrapper"
            },
            "environment" : {
                "NVCC_WRAPPER_DEFAULT_COMPILER" : "g++"
            }
        },
        {
            "$comment": "Inherit from this preset to use clang-tidy.",
            "name"          : "clang-tidy",
            "hidden"        : true,
            "cacheVariables": {"KokkosUtils_ENABLE_CLANG_TIDY" : "ON"}
        },
        {
            "$comment": "Inherit from this preset to use C++23.",
            "name" : "cxx23",
            "hidden" : true,
            "cacheVariables" : {"CMAKE_CXX_STANDARD": "23"}
        },
        {
            "name"           : "gcc-OpenMP",
            "inherits"       : ["gcc", "cxx23", "default"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP"
            }
        },
        {
            "name"           : "clang-OpenMP",
            "inherits"       : ["clang-tidy", "clang", "cxx23", "default"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP"
            }
        },
        {
            "name"           : "nvidia-gcc-Cuda",
            "inherits"       : ["nvidia-gcc", "default"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;CUDA"
            }
        },
        {
            "name"           : "clang-Cuda",
            "inherits"       : ["clang", "default"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;CUDA"
            }
        },
        {
            "name"           : "rocm-HIP",
            "inherits"       : ["rocm", "default"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;HIP"
            }
        },
        {
            "name"     : "intel-SYCL",
            "inherits" : ["intel", "default"],
            "cacheVariables" : {
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;SYCL"
            }
        }
    ],
    "buildPresets" : [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "nvidia-gcc-Cuda",
            "configurePreset" : "nvidia-gcc-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-Cuda",
            "configurePreset" : "clang-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "rocm-HIP",
            "configurePreset" : "rocm-HIP",
            "inherits"        : "default"
        },
        {
            "name"            : "intel-SYCL",
            "configurePreset" : "intel-SYCL",
            "inherits"        : "default"
        }
    ],
    "testPresets": [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true,
            "output"          : {"outputOnFailure": true},
            "execution"       : {
                "noTestsAction"  : "error",
                "stopOnFailure"  : false,
                "scheduleRandom" : true
            }
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "nvidia-gcc-Cuda",
            "configurePreset" : "nvidia-gcc-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-Cuda",
            "configurePreset" : "clang-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "rocm-HIP",
            "configurePreset" : "rocm-HIP",
            "inherits"        : "default"
        },
        {
            "name"            : "intel-SYCL",
            "configurePreset" : "intel-SYCL",
            "inherits"        : "default"
        }
    ]
}
