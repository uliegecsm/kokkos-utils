{
    "version": 10,
    "configurePresets" : [
        {
            "$comment": "Configuration common to all available presets.",
            "name"          : "default",
            "hidden"        : true,
            "binaryDir"     : "${sourceDir}/build-with-${presetName}",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE"     : "Release",
                "CMAKE_CXX_STANDARD"   : "20",
                "CMAKE_CXX_EXTENSIONS" : "OFF",
                "BUILD_SHARED_LIBS"    : "ON",
                "CMAKE_C_COMPILER"     : "should-not-be-needed",
                "Kokkos_ENABLE_SERIAL" : "ON",
                "Kokkos_ENABLE_TESTS"  : "OFF"
            }
        },
        {
            "$comment": "Inherit from this preset to use the gcc compiler family.",
            "name"           : "gcc",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "g++"}
        },
        {
            "$comment": "Inherit from this preset to use the clang compiler family.",
            "name"           : "clang",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "clang++"}
        },
        {
            "$comment": "Inherit from this preset to use the intel compiler family.",
            "name"           : "intel",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "icpx"}
        },
        {
            "$comment": "Inherit from this preset to use the rocm compiler family.",
            "name"           : "rocm",
            "hidden"         : true,
            "cacheVariables" : {"CMAKE_CXX_COMPILER" : "hipcc"}
        },
        {
            "$comment": "Inherit from this preset to use C++23.",
            "name" : "cxx23",
            "hidden" : true,
            "cacheVariables" : {"CMAKE_CXX_STANDARD": "23"}
        },
        {
            "$comment": "Inherit from this preset to use the OpenMP backend.",
            "name"           : "OpenMP",
            "hidden"         : true,
            "cacheVariables" : {"Kokkos_ENABLE_OPENMP" : "ON"}
        },
        {
            "$comment": "Inherit from this preset to use the Cuda backend.",
            "name"           : "Cuda",
            "hidden"         : true,
            "cacheVariables" : {
                "CMAKE_CXX_COMPILER" : "${sourceDir}/bin/nvcc_wrapper",
                "Kokkos_ENABLE_CUDA" : "ON",
                "Kokkos_ENABLE_CUDA_CONSTEXPR" : "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the HIP backend.",
            "name"           : "HIP",
            "hidden"         : true,
            "environment" : {
                "ROCM_PATH" : "/opt/rocm"
            },
            "cacheVariables" : {
                "Kokkos_ENABLE_ROCTHRUST" : "OFF",
                "Kokkos_ENABLE_HIP" : "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the SYCL backend.",
            "name"     : "SYCL",
            "hidden"         : true,
            "cacheVariables" : {
                "Kokkos_ENABLE_SYCL" : "ON",
                "$comment": "RDC is enabled because of https://github.com/uliegecsm/kokkos-execution/pull/114#issuecomment-4153192133. It requires building static libs.",
                "Kokkos_ENABLE_SYCL_RELOCATABLE_DEVICE_CODE": "ON",
                "BUILD_SHARED_LIBS": "OFF",
                "Kokkos_ENABLE_ONEDPL" : "OFF",
                "Kokkos_ENABLE_UNSUPPORTED_ARCHS" : "ON",
                "CMAKE_CXX_FLAGS" : "-fp-model=precise",
                "EXPECTED_Kokkos_DEVICES" : "SERIAL;OPENMP;SYCL"
            }
        },
        {
            "name"     : "gcc-OpenMP",
            "inherits" : ["OpenMP", "gcc", "cxx23", "default"]
        },
        {
            "name"     : "clang-OpenMP",
            "inherits" : ["OpenMP", "clang", "cxx23", "default"]
        },
        {
            "name"     : "gcc-Cuda",
            "inherits" : ["Cuda", "OpenMP", "gcc", "default"]
        },
        {
            "name"     : "rocm-HIP",
            "inherits" : ["HIP", "OpenMP", "rocm", "default"]
        },
        {
            "name"     : "intel-SYCL",
            "inherits" : ["SYCL", "OpenMP", "intel", "default"]
        }
    ],
    "buildPresets" : [
        {
            "name"            : "default",
            "configurePreset" : "default",
            "inheritConfigureEnvironment" : true
        },
        {
            "name"            : "gcc-OpenMP",
            "configurePreset" : "gcc-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "clang-OpenMP",
            "configurePreset" : "clang-OpenMP",
            "inherits"        : "default"
        },
        {
            "name"            : "gcc-Cuda",
            "configurePreset" : "gcc-Cuda",
            "inherits"        : "default"
        },
        {
            "name"            : "rocm-HIP",
            "configurePreset" : "rocm-HIP",
            "inherits"        : "default"
        },
        {
            "name"            : "intel-SYCL",
            "configurePreset" : "intel-SYCL",
            "inherits"        : "default"
        }
    ]
}
